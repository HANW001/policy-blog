# systemd 유닛 — policy-blog (Next.js, `next start`)
#
# 설치:
#   sudo cp policy-blog/deploy/policy-blog.service /etc/systemd/system/policy-blog.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now policy-blog
#
# 주의 (quant-family/deploy/quant-app.service와 동일한 원칙):
#   - WorkingDirectory가 핵심이다. Next.js는 `.env.local`을 cwd 기준으로 읽고,
#     `.next/`(빌드 산출물)도 cwd 기준 상대경로로 찾는다.
#     WorkingDirectory를 policy-blog 디렉터리가 아닌 다른 곳(예: 모노레포 루트)으로
#     설정하면 .env.local 미인식 또는 빌드 산출물을 찾지 못해 기동 실패한다.
#   - pj-blog는 모노레포이므로 WorkingDirectory는 저장소 루트가 아니라
#     반드시 `<모노레포 클론 경로>/policy-blog` 여야 한다.
#   - User/Group/경로(/opt/pj-blog)는 예시다. setup.sh 실행 시 동일한 경로/계정을
#     쓰거나, 여기 값을 실제 환경에 맞게 바꿔라.
#   - .env.local은 이 서비스가 시작되기 전에 WorkingDirectory 안에 수동으로
#     배치되어 있어야 한다 (scp로 전송, git에는 없음 — 절대 커밋 금지).
#   - `npm run build`가 서비스 시작 전에 이미 완료되어 있어야 한다
#     (setup.sh가 자동 실행. 코드 갱신 시 재빌드 후 재시작 필요).
#   - `next start`는 Next.js가 내부적으로 항상 NODE_ENV=production으로 강제
#     실행한다. 아래 Environment="NODE_ENV=production"은 안전장치일 뿐 필수는
#     아니다 — src/middleware.ts의 /admin 차단은 이 강제 동작에 의존한다.

[Unit]
Description=policy-blog (Next.js, next start)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/pj-blog/policy-blog
Environment="NODE_ENV=production"
Environment="PATH=/usr/bin:/usr/local/bin"
ExecStart=/usr/bin/npm start -- -p 3001
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=policy-blog

# 리소스/보안 하드닝 (선택 — 필요 시 조정)
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
